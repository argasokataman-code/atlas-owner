{
  "name": "atlas-owner",
  "version": "0.7.5",
  "description": "Product Owner graph memory for any project. Modular auto-sharded JSON graph + CLI (init/record/query/get/check) + opencode enforce plugin. Scales to 10k nodes, zero dependencies.",
  "license": "MIT",
  "type": "module",
  "author": "argasokataman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argasokataman-code/atlas-owner.git"
  },
  "bin": {
    "atlas": "skill/scripts/atlas.mjs"
  },
  "files": [
    "skill",
    "plugin",
    "AGENTS.md"
  ],
  "keywords": [
    "opencode",
    "skill",
    "plugin",
    "memory",
    "graph",
    "product-owner",
    "mcp",
    "claude"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "version": "node -e \"const fs=require('fs'),p='skill/scripts/atlas.mjs',v=process.env.npm_package_version;fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/^const VERSION = '[^']*'/m,'const VERSION = \\''+v+'\\''))\""
  }
}
